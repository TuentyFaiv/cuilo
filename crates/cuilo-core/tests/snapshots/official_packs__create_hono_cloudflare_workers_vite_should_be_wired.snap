import { Hono } from 'hono'
import { renderer } from './renderer'
import { errorHandler } from "./shared/error-handler";
import { statusBadgeRoutes } from "./modules/status-badges/status-badge.routes";
import { StatusBadgeService } from "./modules/status-badges/status-badge.service";
import { InMemoryStatusBadgeRepository } from "./modules/status-badges/status-badge.repository";
import { statusBadge } from "./shared/middleware/status-badge";

const app = new Hono()
app.use(statusBadge);
app.onError(errorHandler);

app.use(renderer)

app.get('/', (c) => {
  return c.render(<h1>Hello!</h1>)
})

app.route("/status-badges", statusBadgeRoutes(new StatusBadgeService(new InMemoryStatusBadgeRepository())));

export default app
