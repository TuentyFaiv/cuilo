resource · hono (orm)
  src/modules/status-badges/status-badge.drizzle-repository.ts
  src/modules/status-badges/status-badge.model.ts
  src/modules/status-badges/status-badge.prisma-repository.ts
  src/modules/status-badges/status-badge.repository.ts
  src/modules/status-badges/status-badge.routes.test.ts
