import { serve } from '@hono/node-server'
import { Hono } from 'hono'
import { errorHandler } from "./shared/error-handler.js";
import { statusBadgeRoutes } from "./modules/status-badges/status-badge.routes.js";
import { StatusBadgeService } from "./modules/status-badges/status-badge.service.js";
import { InMemoryStatusBadgeRepository } from "./modules/status-badges/status-badge.repository.js";
import { statusBadge } from "./shared/middleware/status-badge.js";

const app = new Hono()
app.use(statusBadge);
app.onError(errorHandler);

app.get('/', (c) => {
  return c.text('Hello Hono!')
})

app.route("/status-badges", statusBadgeRoutes(new StatusBadgeService(new InMemoryStatusBadgeRepository())));

serve({
  fetch: app.fetch,
  port: 3000
}, (info) => {
  console.log(`Server is running on http://localhost:${info.port}`)
})
