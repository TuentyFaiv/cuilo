{
	"name": "cuilo-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"npm/*"
	],
	"scripts": {
		"check": "biome check .",
		"ci": "biome ci .",
		"docs": "bun run --filter cuilo-docs dev",
		"docs:build": "bun run --filter cuilo-docs build",
		"docs:deploy": "bun run --filter cuilo-docs deploy",
		"docs:deploy-preview": "bun run --filter cuilo-docs deploy:preview",
		"format": "biome format --write .",
		"lint": "biome lint ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	}
}
