---
import type { LucideName } from "../lucide-icons";

import "../../styles/directory.css";

import cli from "../../../../../npm/cli/package.json" with { type: "json" };
import { localized, stackName, ui } from "../../i18n/ui";
import {
	describe,
	exampleOutput,
	installCommand,
	isBuiltIn,
	packNamed,
	packStacks,
	packTrust,
	pieceStacks,
	TRUST_ICONS,
	variantStacks,
} from "../../packs";
import { addCommand } from "../../pieces";
import { parentSection } from "../../sections";
import { compareVariants } from "../../stack-priority";
import LucideIcon from "../lucide-icon.astro";

interface Props {
	/** The pack to show, by name. */
	name: string;
}

/** A code span in an input's description, e.g. `status-badge`. */
const CODE_SPAN = /`([^`]+)`/;
/** The tabs, in order; each panel's id is `pack-<tab>`. */
const TAB_IDS = ["pieces", "stacks", "permissions", "versions"] as const;

const { name } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const t = ui(locale);
const pack = packNamed(name);
const parent = parentSection(Astro.url.pathname, locale);
/** The icon in each official pack's tile; any other pack shows `package`. */
const packIcons: Record<string, LucideName> = { ui: "layout-grid", backend: "server" };
/** Icon sizes in pixels, from the design. */
const iconSize = { crumb: 13, tile: 32, tier: 13, copy: 14, folder: 14, note: 14 } as const;
const builtIn = isBuiltIn(pack);
const trust = packTrust(pack);
const stacks = packStacks(pack);
const install = installCommand(pack);
/** The pieces with their descriptions in the page's locale; the command keeps the English example it reads. */
const pieces = pack.pieces.map((piece) => ({
	...piece,
	description: describe(piece, locale),
	inputs: piece.inputs.map((input) => ({ ...input, description: describe(input, locale) })),
	path: `${pack.name}/${piece.name}`,
	command: addCommand(pack.name, piece),
	output: exampleOutput(piece.examples),
	stacks: pieceStacks(piece),
}));
/** The stacks grouped by which pieces support them, the groups with the most pieces first. */
const coverage = [
	...Map.groupBy(stacks, (stack) =>
		pieces
			.filter((piece) => piece.stacks.includes(stack))
			.map((piece) => piece.name)
			.join(" ")
	),
]
	.map(([covered, names]) => ({
		pieces: covered.split(" "),
		stacks: names,
		variants: [
			...new Set(pieces.flatMap((piece) => piece.variants.filter((variant) => names.includes(stackName(variant))))),
		].sort(compareVariants),
	}))
	.sort((a, b) => b.pieces.length - a.pieces.length);
/** The packages each piece may add, once each, with the stacks that get them. */
const packages = pieces
	.map((piece) => ({
		path: piece.path,
		items: [
			...new Map(
				piece.dependencies.map((dependency) => [
					`${dependency.ecosystem}:${dependency.name}`,
					{
						...dependency,
						stacks: variantStacks(dependency.variants ?? piece.variants),
					},
				])
			).values(),
		],
	}))
	.filter((piece) => piece.items.length > 0);
const globs = pack.permissions.write ?? [];
const details = [
	[t.packSource, pack.source],
	[t.packVersion, pack.version],
	[t.packLicense, pack.license ?? "—"],
	...(builtIn ? [[t.packSignature, t.packShipsInside]] : []),
	[t.packLockfile, t.packPinned],
];
const tabs = [
	{ id: "pieces", label: t.packPieces, count: pieces.length },
	{ id: "stacks", label: t.packStacks, count: stacks.length },
	{ id: "permissions", label: t.packPermissions },
	{ id: "versions", label: t.packVersions },
];
const tierLabel = { builtIn: t.directoryBuiltIn, reviewed: t.directoryReviewed, signed: t.directorySignedShort }[trust];
/** Before the first paint, shows only the tab the URL's hash names (`#tab-<tab>`, or the panel's own id), or Pieces. */
const tabScript = `(() => {
	const root = document.currentScript && document.currentScript.parentElement;
	if (!root) return;
	const tabs = ${JSON.stringify(TAB_IDS)};
	root.dataset.active = tabs.find((tab) => location.hash === "#tab-" + tab || location.hash === "#pack-" + tab) || "pieces";
	root.dataset.tabbed = "";
})();`;

/** `text` split into plain parts and code spans, which sit at odd indexes. */
const withCode = (text: string | null) => (text ?? "").split(CODE_SPAN);
---

<div class="cu-bleed cu-pack not-content" data-pack-page data-copied={t.copied} data-tabs-label={t.packSections}>
	<script is:inline set:html={tabScript} />
	<noscript
		><style is:inline>
			.cu-pack [data-needs-js] {
				display: none;
			}
		</style></noscript
	>
	<header class="head">
		{parent && (
			<nav class="breadcrumb" aria-label={t.breadcrumb}>
				<ol>
					<li>
						<a href={localized(locale, parent.link)}>{t[parent.label]}</a>
						<LucideIcon name="chevron-right" size={iconSize.crumb} />
					</li>
					<li aria-current="page">{pack.name}</li>
				</ol>
			</nav>
		)}
		<div class="title-row">
			<span class="tile" aria-hidden="true">
				<LucideIcon name={packIcons[pack.name] ?? "package"} size={iconSize.tile} />
			</span>
			<div class="title-text">
				<div class="title-line">
					<h1 id="_top">{pack.name}</h1>
					<span class:list={["cu-tier", "tier", `cu-tier--${trust}`]}>
						<LucideIcon name={TRUST_ICONS[trust]} size={iconSize.tier} />
						{tierLabel}
					</span>
					<span class="version">{[pack.version, pack.license].filter(Boolean).join(" · ")}</span>
				</div>
				<p class="description">{describe(pack, locale)}</p>
			</div>
			<div class="install">
				<span class="prompt" aria-hidden="true">$</span>
				<code title={t.packInstall}>{install}</code>
				<button
					type="button"
					class="install-copy cu-control cu-control--compact cu-control--icon cu-control--ghost"
					aria-label={t.copyCommand}
					data-copy={install}
					data-needs-js
				>
					<LucideIcon name="copy" />
				</button>
			</div>
		</div>
		<div class="tablist" data-tablist>
			{tabs.map((tab) => (
				<a href={`#pack-${tab.id}`} id={`pack-${tab.id}-tab`} class="tab" data-tab={tab.id}>
					{tab.label}
					{tab.count !== undefined && <span class="tab-count">{tab.count}</span>}
				</a>
			))}
		</div>
	</header>
	<div class="cu-bleed-body body">
		<div class="panels">
			<section class="panel" id="pack-pieces" data-panel="pieces" aria-labelledby="pack-pieces-tab">
				<h2 class="panel-title">{t.packPieces}</h2>
				{pieces.map((piece) => (
					<article class="piece" id={piece.name} aria-labelledby={`piece-${piece.name}`}>
						<div class="piece-head">
							<p class="piece-title">
								<span id={`piece-${piece.name}`} class="piece-name">
									{piece.path}
								</span>
								<span class="piece-kind">{piece.kind === "piece" ? t.piece : piece.kind}</span>
							</p>
							<button
								type="button"
								class="command cu-control cu-control--compact"
								aria-label={`${t.copyCommand}: ${piece.command}`}
								data-copy={piece.command}
							>
								<code>{piece.command}</code>
								<LucideIcon name="copy" size={iconSize.copy} />
							</button>
						</div>
						<p class="piece-description">{piece.description}</p>
						{piece.inputs.length > 0 ? (
							<table class="inputs">
								<caption class="sr-only">{`${t.packInputs}: ${piece.path}`}</caption>
								<tbody>
									{piece.inputs.map((input) => (
										<tr>
											<th scope="row">
												<code class="input-name">{input.name}</code>
												<span class="input-type">{input.type}</span>
											</th>
											<td>
												{withCode(input.description).map((part, index) =>
													index % 2 === 1 ? <code class="input-code">{part}</code> : part
												)}
												{input.required && <span class="input-note">{t.required}</span>}
												{input.default !== null && input.default !== undefined && (
													<span class="input-note">
														{t.packDefault} <code>{String(input.default)}</code>
													</span>
												)}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						) : (
							<p class="no-inputs">{t.packNoInputs}</p>
						)}
						{piece.output && (
							<p class="output">
								<LucideIcon name="folder" size={iconSize.folder} />
								<span>
									<span class="sr-only">{`${t.packWritesTo} `}</span>
									<code>{piece.output.folder}</code>
									{` (${piece.output.stack})`}
								</span>
							</p>
						)}
					</article>
				))}
			</section>

			<section class="panel" id="pack-stacks" data-panel="stacks" aria-labelledby="pack-stacks-tab">
				<h2 class="panel-title">{t.packStacks}</h2>
				<p class="panel-lead">
					{t.packStacksLead
						.split("--variant")
						.map((part, index) => (index > 0 ? [<code>--variant</code>, part] : part))}
				</p>
				<ul class="coverage">
					{coverage.map((group) => (
						<li class="card">
							<p class="covered-by">
								{group.pieces.map((piece) => (
									<a href={`#${piece}`} class="piece-link">
										{`${pack.name}/${piece}`}
									</a>
								))}
							</p>
							<ul class="chips">
								{group.stacks.map((stack) => (
									<li class="cu-chip">{stack}</li>
								))}
							</ul>
							<p class="variants">
								<code>--variant</code> {group.variants.join(", ")}
							</p>
						</li>
					))}
				</ul>
			</section>

			<section class="panel" id="pack-permissions" data-panel="permissions" aria-labelledby="pack-permissions-tab">
				<h2 class="panel-title">{t.packPermissions}</h2>
				<div class="card">
					<h3>{t.packMayWrite}</h3>
					<p class="panel-lead">{t.packMayWriteLead}</p>
					<ul class="globs">
						{globs.map((glob) => (
							<li>
								<code>{glob}</code>
							</li>
						))}
					</ul>
				</div>
				<div class="card">
					<h3>{t.packPackagesTitle}</h3>
					<p class="note">
						<LucideIcon name="package-plus" size={iconSize.note} />
						{pack.permissions.dependencies ? t.packDependencies : t.packNoDependencies}
					</p>
					{packages.map((piece) => (
						<div class="package-group">
							<h4>{piece.path}</h4>
							<ul class="package-list">
								{piece.items.map((item) => (
									<li>
										<code class="package-name">{item.name}</code>
										<code class="package-version">{item.version}</code>
										<span class="package-meta">
											{[item.ecosystem, item.dev ? t.packPackageDev : undefined].filter(Boolean).join(" · ")}
										</span>
										<span class="package-stacks">{item.stacks.join(", ")}</span>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</section>

			<section class="panel" id="pack-versions" data-panel="versions" aria-labelledby="pack-versions-tab">
				<h2 class="panel-title">{t.packVersions}</h2>
				<div class="card version-card">
					<p class="version-row">
						<code class="version-number">{pack.version}</code>
						<span class="current">{t.packVersionCurrent}</span>
						{builtIn && <span class="ships">{t.packVersionShips.replace("{version}", cli.version)}</span>}
					</p>
					<p class="panel-lead">{t.packVersionsNote}</p>
					<a class="changelog" href={localized(locale, "/changelog/")}>
						{t.packChangelog}
						<LucideIcon name="arrow-right" size={iconSize.note} />
					</a>
				</div>
			</section>
		</div>

		<aside class="aside" aria-label={t.packDetails}>
			<section class="card">
				<h2>{t.packDetails}</h2>
				<dl>
					{details.map(([key, value]) => (
						<div>
							<dt>{key}</dt>
							<dd>{value}</dd>
						</div>
					))}
				</dl>
			</section>
			<section class="card">
				<h2>{t.packMayWrite}</h2>
				<ul class="globs">
					{globs.map((glob) => (
						<li>
							<code>{glob}</code>
						</li>
					))}
				</ul>
				{pack.permissions.dependencies && (
					<p class="note">
						<LucideIcon name="package-plus" size={iconSize.note} />
						{t.packDependencies}
					</p>
				)}
			</section>
			<section class="card">
				<h2>{t.packStacks}</h2>
				<ul class="chips">
					{stacks.map((stack) => <li class="cu-chip">{stack}</li>)}
				</ul>
			</section>
		</aside>
	</div>
	<p class="sr-only" role="status" data-copy-status></p>
</div>

<script>
	import { wireCopyButtons } from "../copy";

	const root = document.querySelector<HTMLElement>("[data-pack-page]");
	const tablist = root?.querySelector<HTMLElement>("[data-tablist]");
	const tabs = [...(root?.querySelectorAll<HTMLAnchorElement>("[data-tab]") ?? [])];
	const PANEL_PREFIX = "pack-";
	/** The hash a chosen tab keeps in the URL; no element has it as id, so reloading doesn't scroll past the tabs. */
	const TAB_PREFIX = "tab-";

	const panelOf = (tab: HTMLElement) => root?.querySelector<HTMLElement>(`#${PANEL_PREFIX}${tab.dataset.tab}`);

	/** Shows the tab named `id`, e.g. `stacks`; with `focus`, moves focus to it, and with `remember`, keeps it in the URL. */
	function select(id: string, { focus = false, remember = false } = {}) {
		if (!root) {
			return;
		}
		root.dataset.active = id;
		for (const tab of tabs) {
			const selected = tab.dataset.tab === id;
			tab.setAttribute("aria-selected", String(selected));
			tab.tabIndex = selected ? 0 : -1;
			if (selected && focus) {
				tab.focus();
			}
		}
		if (remember) {
			const hash = id === "pieces" ? "" : `#${TAB_PREFIX}${id}`;
			history.replaceState(history.state, "", `${location.pathname}${location.search}${hash}`);
		}
	}

	/**
	 * Opens what the URL's hash names: a tab, or the Pieces tab at a piece. Returns where to scroll: the piece, or the
	 * tabs when the hash is a panel's own id, so the tabs stay in view above it.
	 */
	function followHash(): HTMLElement | undefined {
		const id = decodeURIComponent(location.hash.slice(1));
		const tab = tabs.find((candidate) =>
			[PANEL_PREFIX, TAB_PREFIX].some((prefix) => `${prefix}${candidate.dataset.tab}` === id)
		);
		if (tab?.dataset.tab) {
			select(tab.dataset.tab);
			return id.startsWith(PANEL_PREFIX) ? (tablist ?? undefined) : undefined;
		}
		const piece = id ? root?.querySelector<HTMLElement>(`[data-panel="pieces"] #${CSS.escape(id)}`) : null;
		if (!piece) {
			return;
		}
		select("pieces");
		return piece;
	}

	/** Scrolls to what the hash names now, and again once web fonts have loaded and may have moved it. */
	function scrollToHash() {
		const target = followHash();
		if (target) {
			requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
			document.fonts.ready.then(() => target.scrollIntoView({ block: "start" }));
		}
	}

	function onKeyDown(event: KeyboardEvent) {
		const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
		const last = tabs.length - 1;
		const moves = new Map([
			["ArrowRight", current === last ? 0 : current + 1],
			["ArrowLeft", current === 0 ? last : current - 1],
			["Home", 0],
			["End", last],
		]);
		const next = tabs[moves.get(event.key) ?? -1];
		if (next?.dataset.tab) {
			event.preventDefault();
			select(next.dataset.tab, { focus: true, remember: true });
		}
	}

	if (root && tablist) {
		tablist.setAttribute("role", "tablist");
		tablist.setAttribute("aria-label", root.dataset.tabsLabel ?? "");
		for (const tab of tabs) {
			const panel = panelOf(tab);
			tab.setAttribute("role", "tab");
			tab.setAttribute("aria-controls", panel?.id ?? "");
			panel?.setAttribute("role", "tabpanel");
			panel?.setAttribute("tabindex", "0");
			tab.addEventListener("click", (event) => {
				event.preventDefault();
				select(tab.dataset.tab ?? "pieces", { remember: true });
			});
		}
		tablist.addEventListener("keydown", onKeyDown);
		select(root.dataset.active ?? "pieces");
		scrollToHash();
		addEventListener("hashchange", scrollToHash);
		wireCopyButtons(root, root.dataset.copied ?? "", root.querySelector<HTMLElement>("[data-copy-status]"));
	}
</script>

<style>
	.head {
		display: grid;
		gap: 1.25rem;
		padding: 2.25rem var(--cu-gutter) 0;
	}

	.breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		align-items: center;
		font-size: 0.8125rem;
		color: var(--cu-muted);
	}

	.breadcrumb li {
		display: inline-flex;
		gap: 0.375rem;
		align-items: center;
	}

	.breadcrumb a {
		color: var(--cu-muted);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--cu-ink);
	}

	.breadcrumb [aria-current="page"] {
		font-family: var(--cu-font-mono);
	}

	.title-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
	}

	.tile {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 4.5rem;
		height: 4.5rem;
		color: var(--cu-accent);
		background: var(--cu-surface);
		border: 1px solid var(--cu-line);
		border-radius: 1.125rem;
	}

	.title-text {
		display: grid;
		flex: 1 1 24rem;
		gap: 0.5rem;
		min-width: 0;
	}

	.title-line {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		align-items: center;
	}

	.title-line h1 {
		font-family: var(--cu-font-mono);
		font-size: 2.5rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.tier {
		padding: 0.1875rem 0.5625rem;
		font-weight: 600;
	}

	.version {
		font-family: var(--cu-font-mono);
		font-size: 0.8125rem;
		color: var(--cu-muted);
	}

	.description {
		font-size: 1.125rem;
		line-height: 1.4;
		color: var(--cu-muted);
	}

	.install {
		display: flex;
		flex: none;
		gap: 0.75rem;
		align-items: center;
		max-width: 100%;
		min-height: var(--cu-control-height);
		padding: 0.25rem;
		padding-inline-start: var(--cu-control-pad-x);
		font-family: var(--cu-font-mono);
		font-size: 0.8125rem;
		color: var(--cu-code-ink);
		background: var(--cu-code-bg);
		border-radius: var(--cu-control-radius);
	}

	.install code {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.prompt {
		color: var(--cu-accent-2);
	}

	.install-copy {
		color: var(--cu-code-muted);
	}

	.install-copy > :global(svg) {
		color: inherit;
	}

	.install-copy:hover {
		color: var(--cu-code-ink);
		background: var(--cu-code-line);
	}

	.install-copy[data-copied] {
		color: var(--cu-ok);
	}

	.tablist {
		display: flex;
		gap: 0.25rem;
		padding-top: 0.5rem;
		overflow-x: auto;
		scrollbar-width: none;
		border-bottom: 1px solid var(--cu-line);
	}

	.tab {
		display: inline-flex;
		flex: none;
		gap: 0.375rem;
		align-items: center;
		min-height: var(--cu-control-height);
		padding-inline: var(--cu-control-pad-x);
		margin-bottom: -1px;
		font-size: var(--cu-control-font-size);
		font-weight: 500;
		line-height: 1.2;
		color: var(--cu-muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}

	.tab:hover {
		color: var(--cu-ink);
	}

	.tab[aria-selected="true"] {
		font-weight: 600;
		color: var(--cu-ink);
		border-bottom-color: var(--cu-accent);
	}

	.tab:focus-visible {
		outline-offset: -2px;
	}

	.tab-count {
		padding: 0 0.375rem;
		font-size: 0.6875rem;
		font-weight: 400;
		line-height: 1.2;
		color: var(--cu-muted);
		background: var(--cu-surface-2);
		border-radius: 999px;
	}

	.body {
		grid-template-columns: minmax(0, 1fr) 21.25rem;
	}

	.panels,
	.panel {
		display: grid;
		gap: 1rem;
		min-width: 0;
	}

	.panel:focus-visible {
		outline: 2px solid var(--cu-accent-text);
		outline-offset: 4px;
	}

	.cu-pack[data-tabbed] .panel {
		display: none;
	}

	.cu-pack[data-active="pieces"] [data-panel="pieces"],
	.cu-pack[data-active="stacks"] [data-panel="stacks"],
	.cu-pack[data-active="permissions"] [data-panel="permissions"],
	.cu-pack[data-active="versions"] [data-panel="versions"] {
		display: grid;
	}

	.panel-title {
		font-family: var(--cu-font-body);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--cu-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.cu-pack[data-tabbed] .panel-title {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		white-space: nowrap;
		clip-path: inset(50%);
