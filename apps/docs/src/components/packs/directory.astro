---
import { Icon } from "@astrojs/starlight/components";

import packs from "../../data/packs.json" with { type: "json" };
import { localized, stackName, ui } from "../../i18n/ui";

const { locale } = Astro.locals.starlightRoute;
const t = ui(locale);
const rows = packs.map((pack) => ({
	...pack,
	href: localized(locale, `/packs/${pack.name}/`),
	stacks: new Set(pack.pieces.flatMap((piece) => piece.variants.map((variant) => stackName(variant)))).size,
	text: `${pack.name} ${pack.description} ${pack.pieces.map((piece) => piece.name).join(" ")}`.toLowerCase(),
}));
---

<div class="directory not-content" data-directory>
	<label class="search">
		<span class="sr-only">{t.searchLabel}</span>
		<Icon name="magnifier" />
		<input type="search" placeholder={t.searchPlaceholder} data-query autocomplete="off">
	</label>
	<p class="count"><span data-count>{rows.length}</span> {t.directoryCount}</p>
	<ul class="list">
		{rows.map((pack) => (
			<li data-text={pack.text}>
				<div class="info">
					<p class="title">
						<a href={pack.href} class="cu-mono">
							{pack.name}
						</a>
						<span class="tier">
							<Icon name="puzzle" size="0.8rem" />
							{t.directoryBuiltIn}
						</span>
						<span class="cu-mono version">{pack.version}</span>
					</p>
					<p class="description">{pack.description}</p>
					<p class="meta">
						{pack.pieces.length} {t.pieces} · {pack.stacks} {t.stacks}
					</p>
				</div>
				<p class="source">
					<code>{pack.source}</code>
					<code class="show">cuilo pack show {pack.name}</code>
				</p>
			</li>
		))}
	</ul>
	<p class="community">
		<Icon name="information" />
		{t.directoryCommunity}
	</p>
</div>

<script>
	const WHITESPACE = /\s+/;
	const directory = document.querySelector<HTMLElement>("[data-directory]");
	const query = directory?.querySelector<HTMLInputElement>("[data-query]");
	const count = directory?.querySelector<HTMLElement>("[data-count]");
	const items = [...(directory?.querySelectorAll<HTMLLIElement>("li[data-text]") ?? [])];

	query?.addEventListener("input", () => {
		const words = query.value.toLowerCase().split(WHITESPACE).filter(Boolean);
		let shown = 0;
		for (const item of items) {
			const text = item.dataset.text ?? "";
			item.hidden = !words.every((word) => text.includes(word));
			if (!item.hidden) {
				shown += 1;
			}
		}
		if (count) {
			count.textContent = String(shown);
		}
	});
</script>

<style>
	.directory {
		display: grid;
		gap: 1rem;
		margin-top: 2rem;
	}

	.search {
		display: flex;
		gap: 0.7rem;
		align-items: center;
		padding: 0.8rem 1rem;
		color: var(--cu-muted);
		background: var(--cu-surface);
		border: 1px solid var(--cu-line);
		border-radius: var(--cu-radius);
	}

	.search input {
		width: 100%;
		font: inherit;
		color: var(--cu-ink);
		outline: none;
		background: transparent;
		border: 0;
	}

	.count,
	.meta,
	.version {
		margin: 0;
		font-size: 0.85rem;
		color: var(--cu-muted);
	}

	.list {
		padding: 0;
		margin: 0;
		overflow: hidden;
		list-style: none;
		background: var(--cu-surface);
		border: 1px solid var(--cu-line);
		border-radius: var(--cu-radius);
	}

	.list li {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		justify-content: space-between;
		padding: 1.1rem 1.25rem;
	}

	.list li + li {
		border-top: 1px solid var(--cu-line);
	}

	.info {
		display: grid;
		flex: 1 1 20rem;
		gap: 0.35rem;
	}

	.info p {
		margin: 0;
	}

	.title {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: center;
	}

	.title a {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--cu-ink);
		text-decoration: none;
	}

	.tier {
		display: inline-flex;
		gap: 0.3rem;
		align-items: center;
		padding: 0.05rem 0.55rem;
		font-size: 0.75rem;
		font-weight: 600;
		background: var(--cu-surface-2);
		border-radius: 999px;
	}

	.description {
		color: var(--cu-ink);
	}

	.source {
		display: grid;
		gap: 0.4rem;
		justify-items: end;
		margin: 0;
	}

	.source code {
		font-family: var(--cu-font-mono);
		font-size: 0.78rem;
		color: var(--cu-muted);
	}

	.source .show {
		padding: 0.25rem 0.6rem;
		color: var(--cu-ink);
		background: var(--cu-surface-2);
		border-radius: var(--cu-radius-small);
	}

	.community {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		margin: 0;
		font-size: 0.9rem;
		color: var(--cu-muted);
	}
</style>
