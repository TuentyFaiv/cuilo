---
import Default from "@astrojs/starlight/components/PageTitle.astro";

import { localized, ui } from "../i18n/ui";
import { parentSection } from "../sections";

const { entry, locale } = Astro.locals.starlightRoute;
const t = ui(locale);
const { generated } = entry.data;
const parent = parentSection(Astro.url.pathname, locale);
---

{parent && (
	<nav class="breadcrumb" aria-label={t.breadcrumb}>
		<ol>
			<li>
				<a href={localized(locale, parent.link)}>{t[parent.label]}</a>
			</li>
			<li aria-current="page">{entry.data.title}</li>
		</ol>
	</nav>
)}
<Default />
{generated && (
	<p class="generated">
		<span class="dot" aria-hidden="true" />
		{t.generatedFrom} <code>{generated}</code>
	</p>
)}

<style>
	.breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 0;
		font-size: 0.9rem;
		color: var(--cu-muted);
		list-style: none;
	}

	.breadcrumb li + li::before {
		margin-inline-end: 0.5rem;
		content: "›";
	}

	.breadcrumb a {
		color: var(--cu-muted);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--cu-ink);
	}

	.breadcrumb [aria-current="page"] {
		font-family: var(--cu-font-mono);
		color: var(--cu-ink);
	}

	.generated {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.25rem 0.75rem;
		margin-top: 0.75rem;
		font-size: 0.8rem;
		color: var(--cu-muted);
		background: var(--cu-surface-2);
		border-radius: 999px;
	}

	.generated code {
		font-family: var(--cu-font-mono);
		font-size: 0.78rem;
	}

	.dot {
		width: 0.45rem;
		height: 0.45rem;
		background: var(--cu-accent);
		border-radius: 50%;
	}
</style>
