---
import type { HTMLAttributes } from "astro/types";
import type { LucideName } from "./lucide-icons";

import LucideIcon from "./lucide-icon.astro";

/** One choice in the list. */
interface Option {
	/** What the select reports when this option is chosen. */
	value: string;
	/** The option's text in the list. */
	label: string;
	/** Shorter text the button shows for this option, e.g. `EN` for English. */
	short?: string;
	/** A page the option opens; such options are links, so they work without JavaScript. */
	href?: string;
	/** The language of `label`, e.g. `es-MX`. */
	lang?: string;
	/** An icon before the label; the `icon` look shows it in the button. */
	icon?: LucideName;
}

type Props = Omit<HTMLAttributes<"div">, "id"> & {
	/** The element id; the list and its options derive theirs from it. */
	id: string;
	/** The select's accessible name. */
	label: string;
	options: Option[];
	/** The chosen option's value; the first option when it matches none. */
	value?: string;
	/** Visible text before the value, e.g. `Sort:`; screen readers hear `label` instead. */
	prefix?: string;
	/** An icon before the button's text. */
	icon?: LucideName;
	/** How the button looks: the finder's pill, a form field, the header's compact pill, an outlined pill or a bare icon. */
	look: "pill" | "field" | "compact" | "outline" | "icon";
	/** The edge of the button the list lines up with. */
	align?: "start" | "end";
};

const { id, label, options, value, prefix, icon, look, align = "start", class: className, ...attributes } = Astro.props;
/** Icon sizes in pixels for each look, from the design: the leading icon and the trailing chevron. */
const sizes = {
	pill: { icon: 14, chevron: 14 },
	field: { icon: 14, chevron: 14 },
	compact: { icon: 14, chevron: 12 },
	outline: { icon: 15, chevron: 13 },
	icon: { icon: 19, chevron: 0 },
} as const;
const { icon: iconSize, chevron: chevronSize } = sizes[look];
const optionIconSize = 15;
const chosen = options.find((option) => option.value === value) ?? options[0];
const labelId = `${id}-label`;
const listId = `${id}-list`;
/** Whether the options are links, which a native popover can open without JavaScript. */
const linked = options.every((option) => option.href);
---

<cu-select
	{...attributes}
	class:list={["cu-select", className]}
	value={chosen?.value}
	data-look={look}
	data-align={align}
>
	<span id={labelId} class="sr-only">{label}</span>
	<button
		type="button"
		class="trigger"
		role="combobox"
		id={id}
		aria-labelledby={labelId}
		aria-haspopup="listbox"
		aria-controls={listId}
		aria-expanded="false"
		popovertarget={linked ? listId : undefined}
		data-select-button
	>
		{icon && <LucideIcon name={icon} size={iconSize} class="lead-icon" />}
		{look === "icon" &&
			options.map(
				(option) =>
					option.icon && (
						<span class="option-icon" data-option-icon={option.value} hidden={option !== chosen}>
							<LucideIcon name={option.icon} size={iconSize} />
						</span>
					)
			)}
		<span class:list={["text", { "sr-only": look === "icon" }]}>
			{prefix && <span aria-hidden="true">{`${prefix} `}</span>}
			<span data-select-value>{chosen?.short ?? chosen?.label}</span>
		</span>
		{chevronSize > 0 && (
			<LucideIcon name={look === "field" ? "chevrons-up-down" : "chevron-down"} size={chevronSize} class="chevron" />
		)}
	</button>
	<div class="list" id={listId} role="listbox" aria-labelledby={labelId} tabindex="-1" popover="auto">
		{options.map((option, index) => {
			const TAG = option.href ? "a" : "div";
			return (
				<TAG
					class="option"
					role="option"
					id={`${id}-${index}`}
					href={option.href}
					lang={option.lang}
					hreflang={option.href ? option.lang : undefined}
					aria-selected={option === chosen ? "true" : "false"}
					data-value={option.value}
					data-short={option.short}
				>
					{option.icon && <LucideIcon name={option.icon} size={optionIconSize} class="option-lead" />}
					<span data-option-label>{option.label}</span>
					<LucideIcon name="check" size={optionIconSize} class="tick" />
				</TAG>
			);
		})}
	</div>
</cu-select>

<script>
	import "./select-menu.ts";
</script>

<style>
	.cu-select {
		position: relative;
		display: inline-flex;
		flex: none;
	}

	.trigger {
		display: inline-flex;
		gap: 0.375rem;
		align-items: center;
		min-width: 0;
		padding: 0;
		font: inherit;
		color: var(--cu-muted);
		white-space: nowrap;
		cursor: pointer;
		background: none;
		border: 1px solid transparent;
	}

	.trigger:hover,
	.trigger[aria-expanded="true"] {
		color: var(--cu-ink);
	}

	.trigger:focus-visible {
		outline: 2px solid var(--cu-accent-text);
		outline-offset: 2px;
	}

	.trigger > :global(svg),
	.option-icon {
		flex: none;
	}

	.option-icon {
		display: inline-flex;
	}

	.option-icon[hidden] {
		display: none;
	}

	.text {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	[data-look="pill"] .trigger {
		padding: 0.375rem 0.625rem;
		font-size: 0.8125rem;
		line-height: 1.2;
		background: var(--cu-surface-2);
		border-radius: 999px;
	}

	[data-look="field"] .trigger {
		gap: 0.5rem;
		padding: 0.75rem 0.875rem;
		font-size: 0.875rem;
		line-height: 1.2;
		color: var(--cu-ink);
		background: var(--cu-surface);
		border-color: var(--cu-line);
		border-radius: 0.625rem;
	}

	[data-look="field"] .trigger:hover {
		border-color: var(--cu-muted);
	}

	[data-look="compact"] .trigger {
		gap: 0.3125rem;
		padding: 0.3125rem 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.2;
		border-color: var(--cu-line);
		border-radius: var(--cu-radius-small);
	}

	[data-look="outline"] .trigger {
		padding: 0.4375rem 0.625rem;
		font-size: 0.8125rem;
		line-height: 1.2;
		border-color: var(--cu-line);
		border-radius: var(--cu-radius-small);
	}

	[data-look="outline"] .text {
		color: var(--cu-ink);
	}

	[data-look="icon"] .trigger {
		justify-content: center;
		min-width: 1.75rem;
		min-height: 1.75rem;
		border-radius: var(--cu-radius-small);
	}

	[data-look="field"] :global(.chevron),
	[data-look="outline"] :global(.chevron) {
		color: var(--cu-muted);
	}

	[data-look="field"] :global(.chevron) {
		margin-inline-start: auto;
	}

	.list {
		position: fixed;
		inset: auto;
		box-sizing: border-box;
		max-width: calc(100vw - 1rem);
		padding: 0.25rem;
		margin: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		font-size: 0.875rem;
		line-height: 1.3;
		color: var(--cu-ink);
		background: var(--cu-surface);
		border: 1px solid var(--cu-line);
		border-radius: 0.625rem;
		box-shadow: 0 0.75rem 2rem var(--cu-shadow);
		opacity: 1;
		transform: none;
		transition:
			opacity 0.12s ease-out,
			transform 0.12s ease-out;
	}

	.list:popover-open:not([data-placed]) {
		opacity: 0;
		transform: translateY(-0.25rem);
	}

	.list[data-side="top"]:popover-open:not([data-placed]) {
		transform: translateY(0.25rem);
	}

	.option {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.4375rem 0.625rem;
		color: var(--cu-ink);
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		border-radius: 0.375rem;
	}

	.option > span {
		flex: 1;
	}

	.option :global(.option-lead) {
		color: var(--cu-muted);
	}

	.option :global(.tick) {
		visibility: hidden;
		color: var(--cu-accent-text);
	}

	.option[aria-selected="true"] :global(.tick) {
		visibility: visible;
	}

	.option[data-active] {
		background: var(--cu-surface-2);
	}

	.option:hover {
		color: var(--cu-ink);
	}

	@media (prefers-reduced-motion: reduce) {
		.list {
			transition: none;
		}

		.list:popover-open:not([data-placed]),
		.list[data-side="top"]:popover-open:not([data-placed]) {
			transform: none;
		}
	}
</style>
