---
import { Code, Icon, TabItem, Tabs } from "@astrojs/starlight/components";

import "../styles/landing.css";

import { ui } from "../i18n/ui";

const { entry, locale } = Astro.locals.starlightRoute;
const t = ui(locale);
const { hero } = entry.data;
const install = [
	[t.installUnix, "curl --proto '=https' --tlsv1.2 -fsSL https://dl.cuilo.dev/install.sh | sh"],
	[t.installWindows, "irm https://dl.cuilo.dev/install.ps1 | iex"],
	["npm", "npm install --global @cuilo/cli"],
	["pnpm", "pnpm add --global @cuilo/cli"],
	["Bun", "bun add --global @cuilo/cli"],
	["Homebrew", "brew install tuentyfaiv/tap/cuilo"],
	["Cargo", "cargo binstall cuilo"],
];
---

{hero && (
	<section class="cu-hero">
		<p class="cu-eyebrow">
			<span class="cu-mini-strata" aria-hidden="true">
				<span />
				<span />
				<span />
			</span>
			{t.heroEyebrow}
		</p>
		<h1 id="_top">
			<Fragment set:html={hero.title ?? entry.data.title} />
		</h1>
		{hero.tagline && <p class="cu-tagline" set:html={hero.tagline} />}
		{hero.actions.length > 0 && (
			<div class="cu-actions">
				{hero.actions.map((action) => (
					<a
						class:list={["cu-button", action.variant === "primary" ? "cu-button--primary" : "cu-button--secondary"]}
						href={action.link}
					>
						{action.text}
						{action.icon?.type === "icon" && <Icon name={action.icon.name} />}
					</a>
				))}
			</div>
		)}
		<div class="cu-install not-content">
			<Tabs syncKey="install">
				{install.map(([label, command]) => (
					<TabItem label={label}>
						<Code code={command} lang="sh" />
					</TabItem>
				))}
			</Tabs>
			<p class="cu-install-note">
				<Icon name="approve-check-circle" />
				{t.installNote}
			</p>
		</div>
	</section>
)}
